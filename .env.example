# Base de données (SQLite en local)
DATABASE_URL="file:./dev.db"

# URL publique du site (production) - utilisée pour le sitemap, robots.txt
# et les métadonnées Open Graph des pages publiques (fiches studio/artiste,
# forum). Sans cette variable, la valeur par défaut est http://localhost:3000.
NEXT_PUBLIC_SITE_URL="https://votre-domaine.fr"

# Clés VAPID (identité du serveur de notifications push) - propres à chaque
# instance, à générer une fois avec `npx web-push generate-vapid-keys` et à
# ne jamais committer. Aucun compte tiers requis (contrairement à Resend/
# Twilio pour un vrai envoi email/SMS, non branchés pour l'instant).
WEB_PUSH_VAPID_PUBLIC_KEY=""
WEB_PUSH_VAPID_PRIVATE_KEY=""
WEB_PUSH_CONTACT_EMAIL="mailto:contact@votre-domaine.fr"
NEXT_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY=""
