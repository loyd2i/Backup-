// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Utilisateur (artiste, ingénieur, ou gestionnaire de studio)
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  password     String
  name         String
  phone        String?
  role         String   @default("artiste") // artiste, ingenieur, gestionnaire, studio_owner
  avatar       String?

  // Fiche publique artiste (vitrine)
  bio          String?  // Courte présentation
  city         String?  // Ville / région
  genre        String?  // Genre musical / spécialité
  instagram    String?
  spotify      String?
  soundcloud   String?
  youtube      String?
  website      String?

  // Solde des ventes marketplace (sample packs / instrus), commission
  // plateforme déjà déduite - voir MarketplaceItem/MarketplacePurchase.
  walletBalance Float   @default(0)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  // Relations
  studios           Studio[]          @relation("StudioOwner")
  appointments      Appointment[]
  tracks            Track[]
  texts             Text[]
  sentMessages      Message[]         @relation("SentMessages")
  receivedMessages  Message[]         @relation("ReceivedMessages")
  invoices          Invoice[]
  forumPosts        ForumPost[]
  forumComments     ForumComment[]
  forumLikes        ForumLike[]
  emailLogs         EmailLog[]
  smsLogs           SmsLog[]
  notifications     Notification[]
  pushSubscriptions PushSubscription[]
  reviewsWritten    Review[]
  reportsFiled      AppointmentReport[]
  waitlistEntries   Waitlist[]
  hoursPacks        HoursPack[]
  trackComments     TrackComment[]
  sharedTracks      TrackShare[]

  // E-Studio (sessions collaboratives à distance)
  hostedEStudioSessions EStudioSession[]     @relation("EStudioHost")
  eStudioParticipations EStudioParticipant[] @relation("EStudioParticipations")
  eStudioChatMessages   EStudioChatMessage[] @relation("EStudioChatMessages")
  eStudioAnnotations    EStudioAnnotation[]  @relation("EStudioAnnotations")

  // Onelib (hub de diffusion des sorties)
  onelibReleases        OnelibRelease[]
  onelibCollections     OnelibCollection[]
  onelibCredits           OnelibCollaborator[]
  onelibCollectionCredits OnelibCollectionCollaborator[]

  // Marketplace (sample packs / instrus entre artistes)
  marketplaceItemsSold     MarketplaceItem[]     @relation("MarketplaceItemsSold")
  marketplacePurchasesMade MarketplacePurchase[] @relation("MarketplacePurchasesMade")

  passwordResetTokens   PasswordResetToken[]
}

// Jeton de réinitialisation de mot de passe (flux "Mot de passe oublié")
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

// Studio d'enregistrement
model Studio {
  id            String   @id @default(cuid())
  name          String
  description   String?
  location      String
  address       String?  // Adresse complète
  type          String   @default("professionnel") // professionnel, home_studio
  pricePerHour  Float    @default(50)
  eStudioPricePerHour Float? // Tarif dédié aux sessions E-Studio (distance) ; null = utilise pricePerHour
  rating        Float    @default(4.5)
  views         Int      @default(0) // Nombre de visites de la fiche publique
  imageUrl      String?
  coverUrl      String?  // Image de couverture (bannière vitrine)
  equipment     String?  // Équipement disponible
  capacity      Int?     // Nombre de personnes max
  latitude      Float?   // Coordonnée GPS pour la carte
  longitude     Float?   // Coordonnée GPS pour la carte
  ownerId       String
  owner         User     @relation("StudioOwner", fields: [ownerId], references: [id])
  isActive      Boolean  @default(true)

  // Nouvelles infos vitrine
  phone         String?  // Téléphone
  website       String?  // Site web
  instagram     String?  // @instagram
  twitter       String?  // @twitter
  facebook      String?  // Facebook URL
  youtube       String?  // YouTube URL
  spotify       String?  // Spotify artist/studio URL
  soundcloud    String?  // Soundcloud URL

  // Facturation
  country       String   @default("FR") // Code pays pour le taux de TVA (voir src/lib/tax-config.ts)

  // Portefeuille studio
  walletBalance Float    @default(0) // Solde disponible (net après commission)
  totalEarnings Float    @default(0) // Cumul historique des gains nets

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  appointments       Appointment[]
  availabilities     Availability[]
  pricingTiers       PricingTier[]
  blocks             StudioBlock[]
  tracks             Track[]     // Tracks travaillées par ce studio
  photos             StudioPhoto[]
  links              StudioLink[]
  walletTransactions WalletTransaction[]
  subscription       StudioSubscription?
  waitlistEntries    Waitlist[]
  hoursPackOffers    HoursPackOffer[]
  hoursPacks         HoursPack[]
  slotDiscounts      SlotDiscount[]
}

// Mouvement du portefeuille studio (crédit après session, commission plateforme)
model WalletTransaction {
  id            String   @id @default(cuid())
  studioId      String
  studio        Studio   @relation(fields: [studioId], references: [id])
  type          String   // earning (crédit net studio), fee (commission plateforme)
  amount        Float
  appointmentId String?
  description   String?
  createdAt     DateTime @default(now())
}

// Abonnement mensuel du studio à la plateforme (s'ajoute à la commission,
// ne la remplace pas). Simulé comme les autres paiements de l'app :
// aucune intégration Stripe réelle, currentPeriodEnd n'est pas facturée
// automatiquement.
model StudioSubscription {
  id                   String    @id @default(cuid())
  studioId             String    @unique
  studio               Studio    @relation(fields: [studioId], references: [id])
  plan                 String    // monthly (sans engagement) | annual (engagement 1 an)
  monthlyPrice         Float     // prix verrouillé au moment de la souscription
  status               String    @default("active") // active, cancelled
  startedAt            DateTime  @default(now())
  currentPeriodEnd     DateTime  // prochaine échéance simulée
  cancelAtPeriodEnd    Boolean   @default(false)
  cancelledAt          DateTime?
  stripeSubscriptionId String?   // simulation : sub_demo_...
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

// Photos du studio
model StudioPhoto {
  id          String   @id @default(cuid())
  studioId    String
  studio      Studio   @relation(fields: [studioId], references: [id], onDelete: Cascade)
  url         String
  caption     String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
}

// Liens personnalisés (Linktree style)
model StudioLink {
  id          String   @id @default(cuid())
  studioId    String
  studio      Studio   @relation(fields: [studioId], references: [id], onDelete: Cascade)
  title       String
  url         String
  icon        String?  // Lucide icon name
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

// Offre de pack d'heures prépayées, figée par studio (voir BUSINESS-PLAN.md
// "Croissance et rétention") - le studio définit son propre forfait remisé.
model HoursPackOffer {
  id        String   @id @default(cuid())
  studioId  String
  studio    Studio   @relation(fields: [studioId], references: [id])
  hours     Float
  price     Float    // prix total du pack, remisé vs pricePerHour * hours
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

// Pack d'heures possédé par un artiste chez un studio précis (non transférable
// à un autre studio), décrémenté à chaque réservation payée avec.
model HoursPack {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  studioId       String
  studio         Studio   @relation(fields: [studioId], references: [id])
  totalHours     Float
  remainingHours Float
  pricePaid      Float
  purchasedAt    DateTime @default(now())

  appointments Appointment[]
}

// Réduction manuelle sur un créneau précis (heures creuses), au cas par cas -
// pas une règle récurrente. Le studio fixe un prix total remisé pour cette
// occurrence unique ; la réduction est consommée dès qu'elle sert à une
// réservation.
model SlotDiscount {
  id              String   @id @default(cuid())
  studioId        String
  studio          Studio   @relation(fields: [studioId], references: [id])
  date            DateTime
  startTime       String
  discountedPrice Float
  createdAt       DateTime @default(now())

  @@unique([studioId, date, startTime])
}

// Grille tarifaire
model PricingTier {
  id          String   @id @default(cuid())
  studioId    String
  studio      Studio   @relation(fields: [studioId], references: [id])
  name        String   // "Heure standard", "Demi-journée", "Journée complète", "Mixage", "Mastering"
  description String?
  price       Float
  duration    Int      // durée en heures (0 = forfait)
  unit        String   @default("heure") // heure, forfait, projet
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Disponibilités du studio (horaires réguliers)
model Availability {
  id        String   @id @default(cuid())
  studioId  String
  studio    Studio   @relation(fields: [studioId], references: [id])
  dayOfWeek Int      // 0-6 (dimanche à samedi)
  startTime String   // "09:00"
  endTime   String   // "18:00"
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@unique([studioId, dayOfWeek])
}

// Blocages / Indisponibilités (jours de repos, vacances, maintenance)
model StudioBlock {
  id          String   @id @default(cuid())
  studioId    String
  studio      Studio   @relation(fields: [studioId], references: [id])
  date        DateTime // Date du blocage
  startTime   String?  // "09:00" ou null pour toute la journée
  endTime     String?  // "18:00" ou null pour toute la journée
  reason      String?  // "Vacances", "Maintenance", "Jour férié", etc.
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@unique([studioId, date, startTime])
}

// Liste d'attente sur un créneau déjà réservé : notifié si le créneau se
// libère (annulation) - voir BUSINESS-PLAN.md "Croissance et rétention".
model Waitlist {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  studioId  String
  studio    Studio   @relation(fields: [studioId], references: [id])
  date      DateTime
  startTime String
  createdAt DateTime @default(now())

  @@unique([userId, studioId, date, startTime])
}

// Rendez-vous / Séance
model Appointment {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id])
  studioId         String
  studio           Studio   @relation(fields: [studioId], references: [id])
  date             DateTime
  startTime        String   // "14:00"
  endTime          String   // "18:00"
  duration         Int      // en heures
  status           String   @default("pending") // pending, confirmed, completed, cancelled
  type             String   @default("studio") // studio (sur place), e_studio (à distance)
  notes            String?
  totalPrice       Float?
  confirmationSent Boolean  @default(false)
  reminderSent     Boolean  @default(false) // rappel 2h avant le début (voir scheduler)
  sessionEndNotified Boolean @default(false) // notif de fin de session + demande d'avis envoyée
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Frais de service artiste (en plus du totalPrice studio), figés au
  // moment de la réservation
  artistCommissionAmount   Float?
  artistCommissionRefunded Boolean? // null tant que non tranché (avant annulation/complétion)

  // Empreinte de paiement
  preAuthorization PreAuthorization?

  // Session E-Studio liée (si type = e_studio, créée à la confirmation)
  eStudioSession   EStudioSession?

  // Payée avec un pack d'heures prépayées plutôt qu'à l'unité (voir
  // BUSINESS-PLAN.md) : déjà réglé à l'achat du pack, pas de nouvelle
  // pré-autorisation ni de facture/crédit portefeuille à la complétion.
  hoursPackId String?
  hoursPack   HoursPack? @relation(fields: [hoursPackId], references: [id])

  reviews Review[]
  reports AppointmentReport[]
}

// Empreinte de paiement (pré-autorisation)
model PreAuthorization {
  id              String   @id @default(cuid())
  appointmentId   String   @unique
  appointment     Appointment @relation(fields: [appointmentId], references: [id])
  amount          Float    // Montant pré-autorisé
  status          String   @default("held") // held, captured, released, failed
  stripeIntentId  String?  // ID du PaymentIntent Stripe
  heldAt          DateTime @default(now())  // Date de mise en hold
  capturedAt      DateTime? // Date de capture (après session)
  releasedAt      DateTime? // Date de libération (annulation)
  releaseReason   String?  // Motif de libération
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Morceau de musique
model Track {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  studioId    String?  // Studio qui a travaillé la track
  studio      Studio?  @relation(fields: [studioId], references: [id])
  title       String
  artist      String
  bpm         Int?
  key         String?
  status      String   @default("in_progress") // in_progress, finished
  audioUrl    String?
  duration    Int?     // Durée en secondes
  isPublic    Boolean  @default(false) // Public ou privé
  coverUrl    String?  // Image de couverture
  views       Int      @default(0) // Nombre de vues

  // Analyse technique automatique à l'upload
  sampleRate  Int?     // Hz (ex: 44100)
  bitDepth    Int?     // bits, uniquement pour les formats non compressés (WAV, FLAC)
  bitrate     Int?     // kbps, uniquement pour les formats compressés (MP3, AAC...)
  audioFormat String?  // WAV, MP3, FLAC, M4A, OGG...

  // Fiche Release
  genre         String?
  releaseDate   DateTime?
  spotifyUrl    String?
  youtubeUrl    String?
  appleMusicUrl String?
  deezerUrl     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  versions        TrackVersion[]
  comments        TrackComment[]
  sharedWith      TrackShare[]
  onelibRelease   OnelibRelease?
  collectionEntries OnelibCollectionTrack[]
}

// Version d'une track (V1, V2, etc.)
model TrackVersion {
  id        String   @id @default(cuid())
  trackId   String
  track     Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  version   Int      @default(1)  // 1 = V1, 2 = V2, etc.
  label     String?  // "Mix initial", "Mix final", etc.
  audioUrl  String
  duration  Int?     // Durée en secondes
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([trackId, version])
}

// Commentaire sur une track
model TrackComment {
  id        String   @id @default(cuid())
  trackId   String
  track     Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  content   String
  timestamp Int?     // Position en secondes dans la track (marqueur horodaté)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Partage sélectif de track privée
model TrackShare {
  id        String   @id @default(cuid())
  trackId   String
  track     Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  userId    String   // Utilisateur avec qui la track est partagée
  user      User     @relation(fields: [userId], references: [id])
  sharedBy  String   // ID de l'utilisateur qui a partagé
  createdAt DateTime @default(now())

  @@unique([trackId, userId]) // Une track ne peut être partagée qu'une fois avec un même utilisateur
}

// Texte / Paroles
model Text {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  artist    String
  content   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Message
model Message {
  id          String   @id @default(cuid())
  senderId    String
  sender      User     @relation("SentMessages", fields: [senderId], references: [id])
  receiverId  String
  receiver    User     @relation("ReceivedMessages", fields: [receiverId], references: [id])
  content     String
  subject     String?
  type        String   @default("message") // message, invoice, reminder
  amount      Float?
  description String?
  isRead      Boolean  @default(false)
  attachments MessageAttachment[] // Pièces jointes
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Pièce jointe d'un message
model MessageAttachment {
  id          String   @id @default(cuid())
  messageId   String
  message     Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  fileName    String
  fileType    String   // image, audio, document, video
  fileUrl     String
  fileSize    Int?     // Taille en octets
  createdAt   DateTime @default(now())
}

// Facture
model Invoice {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  studioName     String
  amount         Float
  description    String
  appointmentId  String?
  status         String   @default("pending") // pending, paid
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Log des emails envoyés
model EmailLog {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  email          String
  type           String   // confirmation, reminder, reminder_3h
  appointmentId  String?
  subject        String
  status         String   @default("sent") // sent, failed
  sentAt         DateTime @default(now())
}

// SMS simulé (même principe qu'EmailLog : loggué, pas de vrai envoi Twilio)
model SmsLog {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  phone         String
  type          String
  appointmentId String?
  message       String
  status        String   @default("sent") // sent, failed
  sentAt        DateTime @default(now())
}

// Notification in-app (centre de notifications, cloche)
model Notification {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  type          String    // booking_requested, booking_confirmed, reminder_2h, session_completed...
  title         String
  body          String
  appointmentId String?
  readAt        DateTime?
  createdAt     DateTime  @default(now())
}

// Abonnement push navigateur (un par appareil/navigateur installé)
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

// Avis croisé en fin de session (voir BUSINESS-PLAN.md notifications).
// direction fixe qui note qui : artist_to_studio ou studio_to_artist.
// La note du studio (Studio.rating) est recalculée à chaque nouvel avis
// artist_to_studio ; les avis studio_to_artist restent privés (visibles
// par le studio auteur uniquement, pas de profil artiste public noté).
model Review {
  id            String      @id @default(cuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  authorId      String
  author        User        @relation(fields: [authorId], references: [id])
  direction     String      // artist_to_studio, studio_to_artist
  rating        Int         // 1 à 5
  comment       String?
  createdAt     DateTime    @default(now())

  @@unique([appointmentId, direction])
}

// Signalement d'un problème sur une session terminée (litige) - traité
// manuellement par l'équipe, pas d'arbitrage automatisé pour l'instant.
// Voir BUSINESS-PLAN.md "Confiance et sécurité".
model AppointmentReport {
  id            String      @id @default(cuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  reporterId    String
  reporter      User        @relation(fields: [reporterId], references: [id])
  reason        String
  status        String      @default("open") // open, resolved
  createdAt     DateTime    @default(now())
}

// ============================================
// FORUM - Amateurs de son
// ============================================

// Catégorie du forum
model ForumCategory {
  id          String      @id @default(cuid())
  name        String
  description String?
  slug        String      @unique
  icon        String?
  order       Int         @default(0)
  posts       ForumPost[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

// Post du forum
model ForumPost {
  id          String        @id @default(cuid())
  title       String
  content     String
  slug        String        @unique
  authorId    String
  author      User          @relation(fields: [authorId], references: [id])
  categoryId  String
  category    ForumCategory @relation(fields: [categoryId], references: [id])
  views       Int           @default(0)
  isPinned    Boolean       @default(false)
  isLocked    Boolean       @default(false)
  comments    ForumComment[]
  likes       ForumLike[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

// Commentaire sur un post
model ForumComment {
  id        String    @id @default(cuid())
  content   String
  postId    String
  post      ForumPost @relation(fields: [postId], references: [id])
  authorId  String
  author    User      @relation(fields: [authorId], references: [id])
  likes     ForumLike[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// Like (post ou commentaire)
model ForumLike {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  postId    String?
  post      ForumPost?  @relation(fields: [postId], references: [id])
  commentId String?
  comment   ForumComment? @relation(fields: [commentId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, postId])
  @@unique([userId, commentId])
}

// ============================================
// E-STUDIO - Sessions collaboratives à distance
// ============================================

model EStudioSession {
  id                String    @id @default(cuid())
  title             String
  hostId            String
  host              User      @relation("EStudioHost", fields: [hostId], references: [id])
  status            String    @default("waiting") // waiting, live, ended
  sessionType       String    @default("session_live") // mixing, mastering, session_live
  audioQuality      String    @default("standard") // standard, high
  enableVideo       Boolean   @default(false)
  enableScreenShare Boolean   @default(true)
  enableChat        Boolean   @default(true)
  enableAnnotations Boolean   @default(false)
  enableRecording   Boolean   @default(false)
  maxParticipants   Int       @default(5)
  iceServers        String?   // Config ICE servers (JSON stringifié)
  signalingToken    String    @unique @default(cuid())
  scheduledStart    DateTime?
  scheduledEnd      DateTime?
  startedAt         DateTime?
  endedAt           DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Réservation liée (session créée depuis une réservation E-Studio)
  appointmentId     String?      @unique
  appointment       Appointment? @relation(fields: [appointmentId], references: [id])

  participants EStudioParticipant[]
  messages     EStudioChatMessage[]
  annotations  EStudioAnnotation[]
  invitations  EStudioInvitation[]
  recordings   EStudioRecording[]
  signals      EStudioSignal[]
}

model EStudioParticipant {
  id              String    @id @default(cuid())
  sessionId       String
  session         EStudioSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId          String
  user            User      @relation("EStudioParticipations", fields: [userId], references: [id])
  role            String    @default("participant") // host, participant
  peerId          String?   // Identifiant de peer WebRTC
  connectionState String    @default("new") // new, connecting, connected, disconnected, failed
  isMuted         Boolean   @default(false)
  isVideoOff      Boolean   @default(true)
  isScreenSharing Boolean   @default(false)
  canShareAudio   Boolean   @default(true)
  canShareVideo   Boolean   @default(true)
  canShareScreen  Boolean   @default(true)
  inputGain       Float     @default(1)
  outputVolume    Float     @default(1)
  joinedAt        DateTime  @default(now())
  leftAt          DateTime?

  @@unique([sessionId, userId])
}

model EStudioChatMessage {
  id        String   @id @default(cuid())
  sessionId String
  session   EStudioSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("EStudioChatMessages", fields: [userId], references: [id])
  content   String
  createdAt DateTime @default(now())
}

model EStudioAnnotation {
  id        String   @id @default(cuid())
  sessionId String
  session   EStudioSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("EStudioAnnotations", fields: [userId], references: [id])
  content   String
  x         Float?
  y         Float?
  createdAt DateTime @default(now())
}

model EStudioInvitation {
  id        String    @id @default(cuid())
  sessionId String
  session   EStudioSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  token     String    @unique @default(cuid())
  createdBy String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model EStudioRecording {
  id        String   @id @default(cuid())
  sessionId String
  session   EStudioSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  fileUrl   String?
  duration  Int?
  createdAt DateTime @default(now())
}

model EStudioTemplate {
  id                String   @id @default(cuid())
  name              String
  sessionType       String
  audioQuality      String   @default("standard")
  enableVideo       Boolean  @default(false)
  enableScreenShare Boolean  @default(true)
  enableChat        Boolean  @default(true)
  enableAnnotations Boolean  @default(false)
  enableRecording   Boolean  @default(false)
  maxParticipants   Int      @default(5)
  createdAt         DateTime @default(now())
}

// Signalisation WebRTC (offer/answer SDP + candidats ICE) échangée par
// polling entre participants d'une même session (mesh P2P direct).
model EStudioSignal {
  id         String   @id @default(cuid())
  sessionId  String
  session    EStudioSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  fromUserId String
  toUserId   String   // destinataire ciblé
  type       String   // offer, answer, ice-candidate
  kind       String   @default("screen") // screen (D1.3, 1 présentateur -> N) ou audio (D1.4, mesh complet)
  payload    String   // SDP ou candidat ICE, JSON stringifié
  createdAt  DateTime @default(now())
}

// Onelib : hub de diffusion d'une track terminée (smart link, QR code, kit de distribution)
model OnelibRelease {
  id              String    @id @default(cuid())
  trackId         String    @unique
  track           Track     @relation(fields: [trackId], references: [id], onDelete: Cascade)
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  slug            String    @unique // URL publique de la page smart link : /o/{slug}
  status          String    @default("draft") // draft, scheduled, published
  scheduledAt     DateTime? // programmation d'une publication future (promue automatiquement à la lecture)
  description     String?
  soundcloudUrl   String?
  coverUrl        String?   // override optionnel (sinon on reprend track.coverUrl)
  views           Int       @default(0)
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Attestation d'auteur (preuve d'antériorité écrite, horodatée — pas un dépôt officiel SACEM)
  authorLegalName String?
  authorSignedAt  DateTime?

  // Demande de distribution (suivi interne : pas de soumission automatique aux vraies plateformes)
  distributionStatus      String    @default("none") // none, requested, in_review, live
  distributionRequestedAt DateTime?

  // Forfait de distribution (modèle TuneCore, simulé — pas de vrai Stripe).
  // Débité à la demande, non remboursé en cas d'annulation avant traitement.
  distributionFeeAmount   Float?
  distributionFeePaidAt   DateTime?
  distributionFeeStripeId String?

  collaborators   OnelibCollaborator[]
}

// Collaborateur crédité sur une release Onelib (doit figurer sur le titre et l'attestation)
model OnelibCollaborator {
  id           String        @id @default(cuid())
  releaseId    String
  release      OnelibRelease @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  name         String
  role         String        @default("compositeur") // compositeur, auteur, featuring, producteur, ingenieur_son
  sharePercent Float?        // part de répartition des royalties (%), formalisée à la demande de distribution
  userId       String?       // liaison optionnelle vers un compte existant (artiste ou studio) pour le crédit public
  user         User?         @relation(fields: [userId], references: [id])
  createdAt    DateTime      @default(now())
}

// Bibliothèque Onelib : regroupement de plusieurs tracks en album ou playlist
model OnelibCollection {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  title           String
  kind            String    // album, playlist
  description     String?
  coverUrl        String?
  slug            String    @unique // URL publique : /o/{slug}
  status          String    @default("draft") // draft, scheduled, published
  scheduledAt     DateTime?
  publishedAt     DateTime?
  views           Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Attestation d'auteur (préuve d'antériorité écrite, horodatée — pas un dépôt officiel SACEM)
  authorLegalName String?
  authorSignedAt  DateTime?

  // Demande de distribution (suivi interne : pas de soumission automatique aux vraies plateformes)
  distributionStatus      String    @default("none") // none, requested, in_review, live
  distributionRequestedAt DateTime?

  // Forfait de distribution (modèle TuneCore, simulé — pas de vrai Stripe).
  // Débité à la demande, non remboursé en cas d'annulation avant traitement.
  distributionFeeAmount   Float?
  distributionFeePaidAt   DateTime?
  distributionFeeStripeId String?

  tracks        OnelibCollectionTrack[]
  collaborators OnelibCollectionCollaborator[]
}

// Track appartenant à un album/playlist Onelib, avec son ordre
model OnelibCollectionTrack {
  id           String           @id @default(cuid())
  collectionId String
  collection   OnelibCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  trackId      String
  track        Track            @relation(fields: [trackId], references: [id])
  order        Int              @default(0)
  createdAt    DateTime         @default(now())

  @@unique([collectionId, trackId])
}

// Collaborateur crédité sur un album/playlist Onelib
model OnelibCollectionCollaborator {
  id           String           @id @default(cuid())
  collectionId String
  collection   OnelibCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  name         String
  role         String           @default("compositeur")
  sharePercent Float?           // part de répartition des royalties (%), formalisée à la demande de distribution
  userId       String?          // liaison optionnelle vers un compte existant (artiste ou studio) pour le crédit public
  user         User?            @relation(fields: [userId], references: [id])
  createdAt    DateTime         @default(now())
}

// Bannière publicitaire (partenariat direct, forfait mensuel fixe — voir
// BUSINESS-PLAN.md). Pas d'interface d'admin : gérées directement en base,
// comme le traitement manuel des demandes de distribution Onelib.
model AdBanner {
  id             String    @id @default(cuid())
  position       String    // left, right
  advertiserName String
  imageUrl       String?   // si absent, une carte texte est affichée à la place
  linkUrl        String
  isActive       Boolean   @default(true)
  startsAt       DateTime?
  endsAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// Article vendu sur le marketplace Onelib (sample pack ou instru) entre
// artistes - commission plateforme alignée sur le taux des réservations
// (voir BUSINESS-PLAN.md "Croissance et rétention").
model MarketplaceItem {
  id          String   @id @default(cuid())
  sellerId    String
  seller      User     @relation("MarketplaceItemsSold", fields: [sellerId], references: [id])
  title       String
  description String?
  category    String   // sample_pack, instru
  price       Float
  audioUrl    String
  coverUrl    String?
  isActive    Boolean  @default(true) // soft delete : les achats déjà faits restent valides
  createdAt   DateTime @default(now())

  purchases MarketplacePurchase[]
}

// Achat d'un article marketplace : donne accès au fichier et crédite le
// vendeur (commission plateforme déjà déduite).
model MarketplacePurchase {
  id               String          @id @default(cuid())
  buyerId          String
  buyer            User            @relation("MarketplacePurchasesMade", fields: [buyerId], references: [id])
  itemId           String
  item             MarketplaceItem @relation(fields: [itemId], references: [id])
  pricePaid        Float
  commissionAmount Float
  createdAt        DateTime        @default(now())

  @@unique([buyerId, itemId])
}
